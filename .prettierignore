# Third-party code, kept byte for byte as it was vendored or locked.
vendor/
package-lock.json

# Written by the scripts, not by hand. Formatting them would fight the generator on every run.
generated/
# Every audit report, the public CV's and each other published CV's, named for its profile and locale (#248).
docs/*_AUDIT*.md

# Installed and updated by the harness tooling, which owns their layout.
.agents/harness/
.agents/skills/

# Written by the local app through ProfileStore, which owns their layout: `JSON.stringify(profile, null, 2)`.
# Prettier sets a short array on one line where that writes one entry a line, so a formatted profile would be
# rewritten by the next save from the editor, and `tests/ProfileStore.test.js` fails on exactly that byte (#230).
profiles/

# Inputs whose exact bytes are what the test checks.
tests/fixtures/
